<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Newser -- AI Digest for {{ date_str }}</title>
<style>
  :root {
    --bg: #f4f5f7;
    --surface: #ffffff;
    --text: #16181d;
    --text-muted: #5b6270;
    --border: #e4e6eb;
    --accent: #6366f1;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f1115;
      --surface: #1a1d24;
      --text: #eceef2;
      --text-muted: #9aa1b0;
      --border: #2a2e38;
      --accent: #818cf8;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.5;
  }
  a { color: inherit; }
  header.hero {
    background: linear-gradient(135deg, #4338ca 0%, #6366f1 45%, #818cf8 100%);
    color: #fff;
    padding: 3rem 1.5rem 2.5rem;
    text-align: center;
  }
  header.hero h1 {
    margin: 0 0 .4rem;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    letter-spacing: -0.02em;
  }
  header.hero .subtitle {
    margin: 0 0 1.2rem;
    opacity: .92;
    font-size: 1.05rem;
  }
  header.hero .stats {
    display: inline-flex;
    gap: .6rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  header.hero .stat-pill {
    background: rgba(255,255,255,.16);
    border: 1px solid rgba(255,255,255,.3);
    border-radius: 999px;
    padding: .35rem .9rem;
    font-size: .85rem;
    font-weight: 600;
  }
  nav.toc {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: .7rem 1rem;
    display: flex;
    gap: .5rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  nav.toc a {
    text-decoration: none;
    font-size: .85rem;
    font-weight: 600;
    padding: .4rem .8rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--text-muted);
    white-space: nowrap;
  }
  nav.toc a:hover { border-color: var(--accent); color: var(--accent); }
  main {
    max-width: 1080px;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }
  section.source-section { margin-bottom: 2.75rem; scroll-margin-top: 4rem; }
  section.source-section h2 {
    display: flex;
    align-items: center;
    gap: .55rem;
    font-size: 1.3rem;
    margin: 0 0 1rem;
    padding-bottom: .5rem;
    border-bottom: 3px solid var(--section-color, var(--accent));
  }
  section.source-section h2 .count {
    font-size: .8rem;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: .1rem .6rem;
    margin-left: auto;
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 4px solid var(--section-color, var(--accent));
    border-radius: 10px;
    padding: 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: .5rem;
  }
  .card a.title {
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    line-height: 1.35;
  }
  .card a.title:hover { color: var(--accent); }
  .card .summary {
    font-size: .87rem;
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card .meta {
    margin-top: auto;
    display: flex;
    gap: .7rem;
    flex-wrap: wrap;
    font-size: .78rem;
    color: var(--text-muted);
  }
  .card .meta .badge {
    display: inline-flex;
    align-items: center;
    gap: .25rem;
  }
  footer {
    text-align: center;
    padding: 2rem 1rem 3rem;
    color: var(--text-muted);
    font-size: .82rem;
  }
  footer a { color: var(--accent); text-decoration: none; }
</style>
</head>
<body>
<header class="hero">
  <h1>&#129302; Newser &mdash; Daily AI Digest</h1>
  <p class="subtitle">{{ date_str }}</p>
  <div class="stats">
    <span class="stat-pill">{{ digest.total_items }} stories</span>
    <span class="stat-pill">{{ digest.source_count }} sources</span>
    <span class="stat-pill">generated {{ generated_at_str }}</span>
  </div>
</header>

{% if digest.sections %}
<nav class="toc">
  {% for section in digest.sections %}
  <a href="#{{ section.key }}">{{ section.icon }} {{ section.name }}</a>
  {% endfor %}
</nav>
{% endif %}

<main>
  {% if not digest.sections %}
  <p style="text-align:center; color: var(--text-muted); padding: 3rem 0;">
    No AI stories were found across any source today.
  </p>
  {% endif %}

  {% for section in digest.sections %}
  <section class="source-section" id="{{ section.key }}" style="--section-color: {{ section.color }};">
    <h2>{{ section.icon }} {{ section.name }} <span class="count">{{ section.items|length }}</span></h2>
    <div class="card-grid">
      {% for item in section.items %}
      <article class="card">
        <a class="title" href="{{ item.url }}" target="_blank" rel="noopener noreferrer">{{ item.title }}</a>
        {% if item.summary %}<p class="summary">{{ item.summary }}</p>{% endif %}
        <div class="meta">
          {% if item.author %}<span class="badge">&#128100; {{ item.author }}</span>{% endif %}
          {% if item.score is not none %}<span class="badge">&#9650; {{ item.score }}</span>{% endif %}
          {% if item.comments is not none %}<span class="badge">&#128172; {{ item.comments }}</span>{% endif %}
          <span class="badge">{{ item.published_str }}</span>
        </div>
      </article>
      {% endfor %}
    </div>
  </section>
  {% endfor %}
</main>

<footer>
  <p>Built by the <strong>Newser</strong> agent harness &middot; sources: Hacker News, Reddit, arXiv, TechCrunch AI, VentureBeat AI, Google News{% if twitter_enabled %}, Twitter/X{% endif %}.</p>
  <p><a href="./archive/index.html">Browse past digests &rarr;</a></p>
</footer>
</body>
</html>
